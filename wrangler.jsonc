// App + API Worker, queue consumer, lane sandboxes and their outbound Worker.
// Resource IDs: database_id is filled in by scripts/ci-provision.ts in CI (it creates the D1 database,
// R2 bucket and queue if they don't exist yet), so this file holds no account-specific IDs.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prose-compare",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  // @cloudflare/sandbox's Files resolves native Linux errno names through node:os.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    // Fails closed: unset, or anything except "false", means the password is required.
    "REQUIRE_PASSWORD": "true",
    // Submissions are disabled when OpenRouter limit_remaining drops below this (USD).
    "CREDIT_FLOOR_USD": "1",
    // Per-lane wall-clock timeout for `opencode run`.
    "LANE_TIMEOUT_MS": "480000",
    // Origin that serves rendered model output. Empty = derive from the request host by swapping the
    // Worker name for "prose-compare-render" (works on workers.dev).
    "RENDER_ORIGIN": ""
  },
  "secrets": {
    "required": ["OPENROUTER_TOKEN", "APP_PASSWORD_HASH"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prose-compare",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "prose-compare-blobs" }],
  "queues": {
    "producers": [{ "binding": "LANES", "queue": "prose-compare-lanes" }],
    "consumers": [
      {
        "queue": "prose-compare-lanes",
        // One message = one lane = one sandbox.
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 1,
        "max_concurrency": 6
      }
    ]
  },
  "ratelimits": [
    // Password attempts: 5 a minute per IP (SPEC.md "Access and cost").
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [{ "name": "SANDBOX", "class_name": "LaneSandbox" }]
  },
  "containers": [
    {
      "class_name": "LaneSandbox",
      "scheduling_policy": "durable_object",
      "max_instances": 12,
      "images": { "sandbox": { "dockerfile": "./Dockerfile" } }
    }
  ],
  "exports": {
    "LaneSandbox": { "type": "durable-object", "storage": "sqlite" }
  },
  "observability": { "enabled": true }
}
